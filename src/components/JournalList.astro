---
// The journal list: topic links, a grid of posts and links between pages.
// Used by /journal/, /journal/page/N/ and the topic pages. No client JS.
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../lib/journal';
import site from '../data/site.json';
import { href } from '../lib/url';

interface Props {
  posts: Post[];
  page: number;
  totalPages: number;
  topics: { slug: string; name: string }[];
  /** Slug of the topic being shown, or undefined for all posts. */
  topic?: string;
}

const { posts, page, totalPages, topics, topic } = Astro.props;
const topicName = topics.find((t) => t.slug === topic)?.name;
const listPath = topic ? `/journal/topic/${topic}/` : '/journal/';
const pagePath = (n: number) => (n === 1 ? listPath : `${listPath}page/${n}/`);

const heading = topicName ? `${site.nav.journal}: ${topicName}` : site.journal.title;
const title = [heading, page > 1 ? `Page ${page}` : ''].filter(Boolean).join(', ');
const description = topicName
  ? `Posts about ${topicName.toLowerCase()} from coach Peter Rothwell.`
  : site.journal.intro;
---

<Base title={title} description={description}>
  <section class="light section">
    <div class="wrap">
      <div class="section-head">
        <h1 class="display h2">{heading}</h1>
        {page > 1 && (
          <p class="mono pageno">
            Page {page} of {totalPages}
          </p>
        )}
      </div>

      {topics.length > 1 && (
        <nav class="topics" aria-label="Topics">
          <a href={href('/journal/')} aria-current={!topic ? 'page' : undefined}>
            All posts
          </a>
          {topics.map((t) => (
            <a href={href(`/journal/topic/${t.slug}/`)} aria-current={t.slug === topic ? 'page' : undefined}>
              {t.name}
            </a>
          ))}
        </nav>
      )}

      {posts.length > 0 ? (
        <div class="grid">
          {posts.map((post) => (
            <PostCard post={post} level="h2" />
          ))}
        </div>
      ) : (
        <p>No posts yet. Check back soon.</p>
      )}

      {totalPages > 1 && (
        <nav class="pager" aria-label="More posts">
          {page > 1 ? (
            <a class="btn btn--ghost" href={href(pagePath(page - 1))} rel="prev">
              ← Newer posts
            </a>
          ) : (
            <span />
          )}
          <span class="mono">
            Page {page} of {totalPages}
          </span>
          {page < totalPages ? (
            <a class="btn btn--ghost" href={href(pagePath(page + 1))} rel="next">
              Older posts →
            </a>
          ) : (
            <span />
          )}
        </nav>
      )}
    </div>
  </section>
</Base>

<style>
  .section-head {
    margin-bottom: 28px;
  }
  .pageno {
    color: var(--ink-muted);
    margin: 0;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 48px;
  }
  .topics a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--chalk-line);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .topics a:hover {
    border-color: var(--granite);
    color: var(--granite);
  }
  .topics a[aria-current='page'] {
    background: var(--granite);
    border-color: var(--granite);
    color: var(--chalk);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 56px 32px;
  }
  .pager {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--chalk-line);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
  }
  .pager .mono {
    color: var(--ink-muted);
  }
  .pager a {
    justify-self: start;
  }
  .pager a:last-child {
    justify-self: end;
  }
  .pager .btn--ghost {
    color: var(--granite);
    border-color: var(--granite);
  }
  .pager .btn--ghost:hover {
    background: var(--chalk-2);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
    .pager a:last-child {
      justify-self: start;
    }
    .pager > span:empty {
      display: none;
    }
  }
</style>
