---
import EnquiryForm from './EnquiryForm.astro';
import Logo from './Logo.astro';
import services from '../data/services.json';
import site from '../data/site.json';
import { getCollection } from 'astro:content';
import { href, telHref } from '../lib/url';

const { contact, location, getInTouch: text, nav } = site;
const policies = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
const year = new Date().getFullYear();
// The same labels as the menu (set in the admin area), plus the reviews and questions headings.
const explore = [
  { label: nav.coaching, path: '/#coaching' },
  { label: nav.runClub, path: '/#runclub' },
  { label: nav.about, path: '/#about' },
  { label: site.reviews.title, path: '/#reviews' },
  { label: nav.journal, path: '/journal/' },
  { label: site.faq.title, path: '/#faq' },
];

// Stroke icons for the ways to get in touch (24×24).
const icons = {
  phone: 'M5 4h3l2 5-2.5 1.5a11 11 0 0 0 6 6L15 14l5 2v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z',
  mail: 'M4 6h16v12H4zM4 7l8 6 8-6',
  insta:
    'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zM12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7zM17.3 6.7h.01',
  pin: 'M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11zM12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z',
};
---

<footer id="contact" class="section footer">
  <div class="wrap grid">
    <div class="intro">
      <span class="mono eyebrow">{text.eyebrow}</span>
      <h2 class="display big">{text.title}</h2>
      <p class="lede">{text.intro}</p>

      <ul class="ways">
        <li>
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d={icons.phone}></path>
            </svg>
          </span>
          <span class="mono label">Text or call</span>
          <a class="value big-value" href={telHref(contact.phone)}>
            {contact.phone.replace(/ /g, ' ')}
          </a>
        </li>
        <li>
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d={icons.mail}></path>
            </svg>
          </span>
          <span class="mono label">Email</span>
          <a class="value" href={`mailto:${contact.email}`}>
            {contact.email}
          </a>
        </li>
        <li>
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d={icons.insta}></path>
            </svg>
          </span>
          <span class="mono label">Instagram</span>
          <a class="value" href={`https://www.instagram.com/${contact.instagram}/`} target="_blank" rel="noopener">
            @{contact.instagram}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
        <li>
          <span class="ico" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d={icons.pin}></path>
            </svg>
          </span>
          <span class="mono label">Train in person or online</span>
          <span class="value">
            {location.address}
            <span class="sub">
              Inside {location.place}
              {' · '}
              <a href={location.mapsUrl} target="_blank" rel="noopener">
                Get directions<span class="visually-hidden"> (opens Google Maps in a new tab)</span>
              </a>
            </span>
            <span class="sub">Or online, wherever you run</span>
          </span>
        </li>
      </ul>
    </div>

    <EnquiryForm />
  </div>

  <div class="base">
    <div class="wrap base-grid">
      <div class="brand">
        <Logo />
        <p>{site.footer.text}</p>
        <a
          class="social"
          href={`https://www.instagram.com/${contact.instagram}/`}
          target="_blank"
          rel="noopener"
          aria-label={`Peter on Instagram, @${contact.instagram} (opens in a new tab)`}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icons.insta}></path>
          </svg>
        </a>
      </div>

      <nav class="col" aria-labelledby="foot-explore">
        <h2 id="foot-explore" class="mono">
          Explore
        </h2>
        <ul>
          {explore.map((l) => (
            <li>
              <a href={href(l.path)}>{l.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="col" aria-labelledby="foot-plans">
        <h2 id="foot-plans" class="mono">
          Coaching
        </h2>
        <ul>
          {services.map((s) => (
            <li>
              <a href={href(s.id === 'runclub' ? '/#runclub' : '/#coaching')}>{s.name}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="col" aria-labelledby="foot-policies">
        <h2 id="foot-policies" class="mono">
          Policies
        </h2>
        <ul>
          {policies.map((p) => (
            <li>
              <a href={href(`/${p.id}/`)}>{p.data.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="wrap base-row">
      <span>
        © {year} {site.name} · {location.area}
      </span>
      <a class="top" href="#top">
        Back to top
        <span aria-hidden="true">↑</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .footer {
    --rule: color-mix(in srgb, var(--ink) 22%, transparent);
    background: var(--gorse);
    color: var(--ink);
    padding-bottom: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(40px, 5vw, 80px);
    /* Both columns end at the same line: the form stretches to the height of the
       left column, and the contact list sits at the bottom of the left column. */
    align-items: stretch;
    padding-bottom: var(--section);
  }

  /* ---------- Left: heading and ways to get in touch ---------- */
  .intro {
    display: flex;
    flex-direction: column;
  }
  .eyebrow {
    margin-bottom: 16px;
  }
  .big {
    font-size: clamp(52px, 5.6vw, 88px);
    max-width: 9em;
  }
  .lede {
    margin: 20px 0 32px;
    font-size: 18px;
    line-height: 1.5;
    max-width: 30em;
  }
  .ways {
    list-style: none;
    margin: auto 0 0;
    padding: 0;
    border-top: 1.5px solid var(--rule);
  }
  .ways li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    grid-template-areas: 'ico label' 'ico value';
    column-gap: 16px;
    row-gap: 2px;
    align-items: center;
    padding-block: 12px;
    border-bottom: 1.5px solid var(--rule);
  }
  .ico {
    grid-area: ico;
    width: 44px;
    height: 44px;
    background: var(--ink);
    display: grid;
    place-items: center;
  }
  .ico svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--gorse);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .label {
    grid-area: label;
    font-size: 11px;
    color: var(--ink-soft);
  }
  .value {
    grid-area: value;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  a.value,
  .sub a {
    text-decoration: none;
  }
  a.value:hover,
  .sub a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .big-value {
    font-size: 24px;
    font-weight: 800;
  }
  .sub {
    display: block;
    margin-top: 2px;
    font-size: 15px;
    font-weight: 500;
  }
  .sub a {
    font-weight: 700;
  }

  /* ---------- Footer proper: brand, links and policies ----------
     Inside .footer the surface tokens keep their dark values in both modes. */
  .base {
    background: var(--granite);
    color: var(--chalk);
    font-size: 15px;
  }
  .base-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 40px 48px;
    padding-block: 64px 48px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }
  .brand p {
    margin: 0;
    max-width: 30em;
    color: var(--muted-2);
    line-height: 1.6;
  }
  .social {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1.5px solid var(--line);
    color: var(--accent);
  }
  .social:hover {
    background: var(--panel);
  }
  .social svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .col h2 {
    margin: 0 0 16px;
    font-size: 11px;
    color: var(--accent);
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .col a,
  .top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    color: var(--muted-2);
    text-decoration: none;
    font-weight: 500;
  }
  .col a:hover,
  .top:hover {
    color: var(--chalk);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .base-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 20px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }

  /* Focus outlines: granite on gorse, gorse on the dark footer below. */
  .footer :focus-visible {
    outline-color: var(--ink);
  }
  .base :focus-visible {
    outline-color: var(--gorse);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .base-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-block: 48px 32px;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 420px) {
    .base-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }
</style>
