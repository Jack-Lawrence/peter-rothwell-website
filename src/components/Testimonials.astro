---
import testimonials from '../data/testimonials.json';
---

<section class="section reviews" aria-labelledby="reviews-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="reviews-title" class="display h2">From the athletes</h2>
      <div class="controls" data-controls hidden>
        <button class="arrow" type="button" data-prev aria-label="Previous reviews">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
        </button>
        <button class="arrow" type="button" data-next aria-label="Next reviews">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
        </button>
      </div>
    </div>

    <ul class="track" data-track role="list" aria-label="Client reviews">
      {
        testimonials.map((t) => (
          <li class="item">
            <figure>
              <blockquote class="bubble">
                <svg class="quote-mark" width="34" height="26" viewBox="0 0 34 26" aria-hidden="true">
                  <path d="M0 26V15C0 6.7 4.4 1.7 13.2 0l1.6 3.6C9.9 5.1 7.6 8 7.4 12H14v14H0zm19 0V15C19 6.7 23.4 1.7 32.2 0l1.6 3.6c-4.9 1.5-7.2 4.4-7.4 8.4H33v14H19z" fill="currentColor"></path>
                </svg>
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="who">
                <span class="avatar" aria-hidden="true">{t.name.charAt(0)}</span>
                <span class="who-text">
                  <b>{t.name}</b>
                  <span class="mono">{t.service}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Arrow buttons scroll the row one card at a time. They only show when
  // there are more reviews than fit on screen.
  document.querySelectorAll<HTMLElement>('.reviews').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-track]')!;
    const controls = section.querySelector<HTMLElement>('[data-controls]')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-next]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const step = () => {
      const item = track.querySelector<HTMLElement>('.item');
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return item ? item.offsetWidth + gap : track.clientWidth;
    };

    const update = () => {
      const overflow = track.scrollWidth > track.clientWidth + 1;
      controls.hidden = !overflow;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    const go = (dir: number) =>
      track.scrollBy({ left: dir * step(), behavior: reduceMotion.matches ? 'auto' : 'smooth' });

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>

<style>
  .reviews {
    background: var(--granite-2);
  }
  .section-head {
    align-items: center;
  }

  .controls {
    display: flex;
    gap: 10px;
  }
  .controls[hidden] {
    display: none;
  }
  .arrow {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1.5px solid var(--gorse);
    background: transparent;
    color: var(--gorse);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, opacity 0.15s ease;
  }
  .arrow:hover:not(:disabled) {
    background: var(--gorse);
    color: var(--granite);
  }
  .arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .track {
    --gap: 24px;
    --per-view: 3;
    list-style: none;
    margin: 0;
    padding: 0 0 4px;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .item {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    scroll-snap-align: start;
    display: flex;
  }
  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    width: 100%;
  }

  /* Speech bubble with a tail pointing down at the client's name. */
  .bubble {
    position: relative;
    flex: 1;
    margin: 0;
    background: var(--chalk);
    color: var(--granite);
    border-radius: 22px;
    padding: 32px 30px 30px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .bubble::after {
    content: '';
    position: absolute;
    left: 34px;
    bottom: -14px;
    width: 28px;
    height: 28px;
    background: var(--chalk);
    border-radius: 0 0 6px 0;
    transform: rotate(45deg);
  }
  .quote-mark {
    color: var(--gorse);
    flex: none;
  }
  .bubble p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-left: 22px;
  }
  .avatar {
    width: 48px;
    height: 48px;
    flex: none;
    border-radius: 50%;
    background: var(--gorse);
    color: var(--granite);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 24px;
  }
  .who-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .who-text b {
    font-size: 17px;
  }
  .who-text .mono {
    color: var(--gorse);
  }

  @media (max-width: 1000px) {
    .track {
      --per-view: 2;
    }
  }
  @media (max-width: 640px) {
    .track {
      --per-view: 1;
      --gap: 16px;
    }
    .bubble {
      padding: 26px 22px 24px;
    }
  }
</style>
