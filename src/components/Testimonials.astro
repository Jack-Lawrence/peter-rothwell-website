---
import data from '../data/testimonials.json';
import site from '../data/site.json';
import { tenureLabel } from '../lib/tenure';

interface Testimonial {
  name: string;
  service: string;
  quote: string;
  started?: string;
  ended?: string;
}

// "Client for 4 months", from the dates set in the admin area. Ongoing clients
// count up to the day the site was last built.
const testimonials = (data as Testimonial[]).map((t) => ({ ...t, tenure: tenureLabel(t.started, t.ended) }));
---

<section id="reviews" class="section reviews" aria-labelledby="reviews-title">
  <div class="wrap">
    <div class="layout">
      <div class="intro">
        <span class="mono label">{site.reviews.eyebrow}</span>
        <h2 id="reviews-title" class="display h2">
          {site.reviews.title}
        </h2>
        <div class="controls" data-controls hidden>
          <button class="arrow" type="button" data-prev aria-label="Previous reviews">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              aria-hidden="true"
            >
              <path d="M15 5l-7 7 7 7"></path>
            </svg>
          </button>
          <button class="arrow" type="button" data-next aria-label="Next reviews">
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              aria-hidden="true"
            >
              <path d="M9 5l7 7-7 7"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- role="list" is deliberate: Safari drops list semantics from unstyled lists. -->
      <!-- [html-validate-disable-next no-redundant-role] -->
      <ul class="track" data-track role="list" aria-label="Client reviews">
        {testimonials.map((t) => (
          <li class="item">
            <figure>
              <blockquote class="bubble">
                <span class="badge" aria-hidden="true">
                  <svg width="22" height="17" viewBox="0 0 34 26">
                    <path
                      d="M0 26V15C0 6.7 4.4 1.7 13.2 0l1.6 3.6C9.9 5.1 7.6 8 7.4 12H14v14H0zm19 0V15C19 6.7 23.4 1.7 32.2 0l1.6 3.6c-4.9 1.5-7.2 4.4-7.4 8.4H33v14H19z"
                      fill="currentColor"
                    ></path>
                  </svg>
                </span>
                {t.tenure && <span class="mono tenure">{t.tenure}</span>}
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="who">
                <span class="avatar" aria-hidden="true">
                  {t.name.charAt(0)}
                </span>
                <span class="who-text">
                  <b>{t.name}</b>
                  <span class="mono">{t.service}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <p class="visually-hidden" data-position aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  // Arrow buttons scroll the row one card at a time. They only show when
  // there are more reviews than fit on screen.
  document.querySelectorAll<HTMLElement>('.reviews').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-track]')!;
    const controls = section.querySelector<HTMLElement>('[data-controls]')!;
    const prev = section.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = section.querySelector<HTMLButtonElement>('[data-next]')!;
    const position = section.querySelector<HTMLElement>('[data-position]')!;
    const items = track.querySelectorAll<HTMLElement>('.item');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let announce = false;

    const step = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return items[0] ? items[0].offsetWidth + gap : track.clientWidth;
    };

    // Which reviews are fully on screen, e.g. "Showing reviews 2 to 3 of 4".
    const visibleRange = () => {
      const box = track.getBoundingClientRect();
      const shown = [...items]
        .map((item, i) => ({ i, r: item.getBoundingClientRect() }))
        .filter(({ r }) => r.left >= box.left - 2 && r.right <= box.right + 2)
        .map(({ i }) => i + 1);
      if (!shown.length) return '';
      const [first, last] = [shown[0], shown[shown.length - 1]];
      return first === last
        ? `Showing review ${first} of ${items.length}`
        : `Showing reviews ${first} to ${last} of ${items.length}`;
    };

    // aria-disabled rather than disabled, so a focused button keeps focus at either end.
    const setEnabled = (button: HTMLButtonElement, enabled: boolean) =>
      button.setAttribute('aria-disabled', String(!enabled));

    let settle = 0;
    const update = () => {
      const overflow = track.scrollWidth > track.clientWidth + 1;
      controls.hidden = !overflow;
      // A scrolling row must be reachable with the keyboard (arrow keys scroll it).
      if (overflow) track.tabIndex = 0;
      else track.removeAttribute('tabindex');
      setEnabled(prev, track.scrollLeft > 1);
      setEnabled(next, track.scrollLeft + track.clientWidth < track.scrollWidth - 1);
      // Announce the new position once scrolling stops, only after an arrow press.
      clearTimeout(settle);
      settle = window.setTimeout(() => {
        if (announce) position.textContent = visibleRange();
        announce = false;
      }, 150);
    };

    const go = (button: HTMLButtonElement, dir: number) => {
      if (button.getAttribute('aria-disabled') === 'true') return;
      announce = true;
      track.scrollBy({ left: dir * step(), behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };

    prev.addEventListener('click', () => go(prev, -1));
    next.addEventListener('click', () => go(next, 1));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    update();
  });
</script>

<style>
  .reviews {
    background: var(--granite-2);
  }
  :global(:root[data-theme='light']) .reviews {
    --bubble: color-mix(in srgb, var(--paper) 25%, white);
  }

  /* Heading in a column on the left, the reviews filling the rest of the row. */
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 2fr);
    gap: 56px;
    align-items: stretch;
  }
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }
  .label {
    color: var(--muted);
  }
  .h2 {
    font-size: clamp(44px, 5vw, 76px);
  }

  .controls {
    display: flex;
    gap: 10px;
    margin-top: auto;
    padding-top: 24px;
  }
  .controls[hidden] {
    display: none;
  }
  .arrow {
    width: 52px;
    height: 52px;
    border: 1.5px solid var(--accent);
    background: transparent;
    color: var(--accent);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease,
      opacity 0.15s ease;
  }
  .arrow:hover:not([aria-disabled='true']) {
    background: var(--gorse);
    border-color: var(--gorse);
    color: var(--ink);
  }
  .arrow[aria-disabled='true'] {
    opacity: 0.3;
    cursor: default;
  }

  .track {
    --gap: 24px;
    --per-view: 2;
    list-style: none;
    margin: 0;
    /* Room above for the quote badges, which sit over the top edge of each card. */
    padding: 34px 0 4px;
    display: flex;
    gap: var(--gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .item {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--gap)) / var(--per-view));
    scroll-snap-align: start;
    display: flex;
  }
  figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  /* Speech bubble with a tail pointing down at the client's name. */
  .bubble {
    position: relative;
    flex: 1;
    margin: 0;
    /* Reviews are light cards in both modes. */
    background: var(--bubble, var(--paper));
    color: var(--ink);
    padding: 48px 36px 36px;
  }
  .bubble::after {
    content: '';
    position: absolute;
    left: 40px;
    bottom: -13px;
    width: 26px;
    height: 26px;
    background: var(--bubble, var(--paper));
    transform: rotate(45deg);
  }
  /* A gorse badge holding the quote mark, half over the card's top edge. */
  .badge {
    position: absolute;
    top: -26px;
    left: 32px;
    width: 52px;
    height: 52px;
    background: var(--gorse);
    color: var(--ink);
    display: grid;
    place-items: center;
    box-shadow: 0 0 0 6px var(--granite-2);
  }
  /* How long they've trained together, top right, level with the quote badge. */
  .tenure {
    position: absolute;
    top: 14px;
    right: 18px;
    padding: 4px 8px;
    background: var(--ink);
    color: var(--paper);
    font-size: 11px;
    line-height: 1.4;
  }
  .bubble p {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-left: 26px;
  }
  .avatar {
    width: 50px;
    height: 50px;
    flex: none;
    border: 1.5px solid var(--accent);
    color: var(--accent);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 26px;
    line-height: 1;
  }
  .who-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .who-text b {
    font-size: 18px;
  }
  .who-text .mono {
    color: var(--muted);
  }

  @media (max-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .intro {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: end;
      justify-content: space-between;
    }
    .intro .label {
      flex-basis: 100%;
    }
    .controls {
      margin-top: 0;
      padding-top: 0;
    }
  }
  @media (max-width: 640px) {
    .track {
      /* One review at a time, with the edge of the next one showing. */
      --per-view: 1.12;
      --gap: 16px;
    }
    .bubble {
      padding: 42px 24px 28px;
    }
    .bubble p {
      font-size: 17px;
    }
    .badge {
      left: 22px;
    }
    /* Not enough room beside the badge for a long label, so it sits above the quote. */
    .tenure {
      position: static;
      display: inline-block;
      margin-bottom: 12px;
    }
    .who {
      padding-left: 14px;
    }
  }
</style>
