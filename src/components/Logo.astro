---
import site from '../data/site.json';
import { href } from '../lib/url';
---

<a class="logo" href={href('/')} aria-label={`${site.name} home`}>
  <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
    <path
      d="M2 28 L11 14 L16 20 L23 8 L32 28 Z"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linejoin="round"
    ></path>
  </svg>
  <span class="display">{site.name}</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }
  svg {
    color: var(--accent);
    flex: none;
  }
  .display {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  /* Phones: leave room for the light/dark and menu buttons. */
  @media (max-width: 420px) {
    .logo {
      gap: 8px;
    }
    .display {
      font-size: 21px;
      letter-spacing: 0.02em;
    }
  }
  @media (max-width: 360px) {
    svg {
      width: 28px;
      height: 28px;
    }
    .display {
      font-size: 17px;
    }
  }
</style>
