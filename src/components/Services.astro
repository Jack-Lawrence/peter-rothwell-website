---
import services from '../data/services.json';
import site from '../data/site.json';
import LocationMap from './LocationMap.astro';
import { scheduleLine, type Schedule } from '../lib/schedule';
import { href } from '../lib/url';

// Wording set in the admin area (Ways to train).
const text = site.coaching;
---

<section id="coaching" class="light services">
  <div class="wrap inner">
    <div class="head">
      <h2 class="display title">{text.title}</h2>
      <p class="lede">{text.intro}</p>
    </div>

    <div class="cards" style={`--count: ${services.length}`}>
      {services.map((s) => (
        <article class="card" id={`plan-${s.id}`}>
          <span class="mono label">{s.label}</span>
          <h3 class="display name">{s.name}</h3>
          <p class="price">
            <span class="display amount">{s.price}</span>
            <span class="per">{s.per}</span>
          </p>
          {scheduleLine((s as { schedule?: Schedule }).schedule) && (
            <p class="mono schedule">{scheduleLine((s as { schedule?: Schedule }).schedule)}</p>
          )}
          <ul>
            {s.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
          <div class="card-actions">
            <a class="enquire" href="#contact" data-enquire={s.name}>
              {text.enquire}
              <span class="visually-hidden"> about {s.name}</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
            {/* The Run Club plan also links to its own section further down. */}
            {s.id === 'runclub' && (
              <a class="more" href={href('/#runclub')}>
                {text.more}
                <span class="visually-hidden"> about {s.name}</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="where">
      <div class="spot spot--map">
        <div class="spot-text">
          <span class="mono label">{text.inPersonLabel}</span>
          <h3 class="display where-title">{site.location.area}</h3>
          <p>
            {site.location.address}
            <br />
            Inside {site.location.place}
          </p>
        </div>
        <a class="map" href={site.location.mapsUrl} target="_blank" rel="noopener">
          <LocationMap />
          <span class="map-pin" aria-hidden="true">
            <svg width="30" height="38" viewBox="0 0 34 44">
              <path d="M17 2C9 2 3 8 3 16c0 11 14 26 14 26s14-15 14-26C31 8 25 2 17 2z" class="pin-body"></path>
              <circle cx="17" cy="16" r="5" class="pin-dot"></circle>
            </svg>
            <span class="mono map-tag">{site.name}</span>
          </span>
          <!-- Named by its visible words first (WCAG 2.5.3), then where it goes. -->
          <span class="map-cta">
            Get directions<span aria-hidden="true"> →</span>
            <span class="visually-hidden">to {site.location.place} on Google Maps (opens in a new tab)</span>
          </span>
        </a>
      </div>

      <div class="spot">
        <svg
          class="pin"
          width="28"
          height="28"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path>
        </svg>
        <div class="spot-text">
          <span class="mono label">{text.onlineLabel}</span>
          <h3 class="display where-title">{text.onlineTitle}</h3>
          <p>{text.onlineText}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // "Enquire" on a card jumps to the form with that plan already chosen.
  document.querySelectorAll<HTMLAnchorElement>('[data-enquire]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('#enq-interest');
      const choice = [...(select?.options ?? [])].find((o) => o.value === link.dataset.enquire);
      if (select && choice) select.value = choice.value;
    });
  });
</script>

<style>
  .inner {
    padding-block: clamp(40px, 6svh, 80px);
    display: flex;
    flex-direction: column;
    gap: clamp(20px, 3svh, 44px);
  }
  /* On desktop the section fills exactly one screen, content centred. */
  @media (min-width: 901px) {
    .services {
      min-height: 100svh;
      display: flex;
      align-items: center;
    }
    .inner {
      flex: 1;
    }
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px 48px;
    flex-wrap: wrap;
  }
  .title {
    font-size: clamp(44px, 5.4vw, 80px);
  }
  .lede {
    margin: 0;
    max-width: 380px;
    color: var(--ink-soft);
  }
  .label {
    color: var(--ink-muted);
  }

  .cards {
    display: grid;
    /* One column per plan (Peter can have 1 to 4). */
    grid-template-columns: repeat(var(--count, 3), minmax(0, 1fr));
    gap: 16px;
  }
  /* Each plan is a coloured panel: loch blue, gorse, bracken (then repeating). */
  .card {
    --pane: var(--loch);
    background: var(--pane);
    color: var(--ink);
    padding: 22px 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .card:nth-child(3n + 2) {
    --pane: var(--gorse);
  }
  .card:nth-child(3n) {
    --pane: var(--bracken);
  }
  /* The softer greys don't have enough contrast on the colours, so everything is ink. */
  .card .label,
  .card .per,
  .card ul {
    color: var(--ink);
  }
  .name {
    font-size: 36px;
    font-weight: 800;
  }
  .price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .amount {
    font-size: 60px;
    line-height: 1;
  }
  .per {
    color: var(--ink-muted);
  }
  .schedule {
    margin: -8px 0 0;
    color: var(--granite);
    font-size: 11px;
    line-height: 1.5;
    text-wrap: balance;
  }
  ul {
    margin: 0 0 10px;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--ink-soft);
    font-size: 16px;
  }
  /* Sits at the bottom of each card, so the three line up. */
  .card-actions {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .enquire,
  .more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 18px;
    background: var(--granite);
    color: var(--chalk);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .enquire:hover {
    background: var(--ink-soft);
  }
  /* "Details": an outline button beside Enquire. */
  .more {
    background: transparent;
    color: var(--granite);
    border: 1.5px solid var(--granite);
  }
  .more:hover {
    background: color-mix(in srgb, var(--granite) 10%, transparent);
  }
  .enquire .arrow {
    color: var(--gorse);
  }

  .where {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 16px;
  }
  .spot {
    display: flex;
    align-items: center;
    gap: 20px;
    background: color-mix(in srgb, var(--paper) 55%, var(--chalk-2));
    padding: 22px 24px;
  }
  .pin {
    flex: none;
    color: var(--granite);
  }
  .spot-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .spot-text p {
    margin: 0;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .where-title {
    font-size: 30px;
  }
  /* In-person card: address on the left, a stylised map filling the right. */
  .spot--map {
    padding: 0;
    align-items: stretch;
    overflow: hidden;
    gap: 0;
  }
  .spot--map .spot-text {
    padding: 22px 24px;
    justify-content: center;
    overflow-wrap: anywhere;
  }
  .map {
    position: relative;
    flex: 0 0 42%;
    min-height: 150px;
    display: block;
    overflow: hidden;
    text-decoration: none;
    background: var(--paper);
  }
  .map-pin {
    position: absolute;
    /* The map drawing is centred on the studio, so the pin's tip sits at the middle. */
    left: 50%;
    top: 50%;
    z-index: 1;
    transform: translate(-50%, -36px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .pin-body {
    fill: var(--ink);
  }
  .pin-dot {
    fill: var(--gorse);
  }
  .map-tag {
    background: var(--granite);
    color: var(--chalk);
    padding: 3px 7px;
    font-size: 10px;
    white-space: nowrap;
  }
  .map-cta {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 1;
    background: var(--granite);
    color: var(--chalk);
    font-weight: 700;
    font-size: 14px;
    padding: 9px 14px;
    transition: background-color 0.15s ease;
  }
  .map:hover .map-cta {
    background: var(--panel);
  }

  @media (max-width: 1100px) {
    .where {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 900px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .card {
      padding: 24px 22px;
    }
    .spot {
      flex-wrap: wrap;
    }
    .spot--map {
      flex-direction: column;
    }
    .map {
      flex-basis: auto;
      min-height: 180px;
    }
  }
</style>
