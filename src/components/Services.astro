---
import services from '../data/services.json';
import site from '../data/site.json';
---

<section id="coaching" class="light services">
  <div class="wrap inner">
    <div class="head">
      <h2 class="display title">Ways to train with me</h2>
      <p class="lede">
        {site.contact.bookingNote}. Every plan starts with a free 15-minute chat about where you are and where you want to get to.
      </p>
    </div>

    <div class="cards">
      {
        services.map((s) => (
          <article class="card" id={s.id}>
            <span class="mono label">{s.label}</span>
            <h3 class="display name">{s.name}</h3>
            <p class="price">
              <span class="display amount">{s.price}</span>
              <span class="per">{s.per}</span>
            </p>
            <ul>
              {s.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="where">
      <div class="spot spot--map">
        <div class="spot-text">
          <span class="mono label">Train in person</span>
          <h3 class="display where-title">{site.location.area}</h3>
          <p>{site.location.address}<br />Inside {site.location.place}</p>
        </div>
        <a class="map" href={site.location.mapsUrl} target="_blank" rel="noopener">
          <span class="map-pin" aria-hidden="true">
            <svg width="30" height="38" viewBox="0 0 34 44">
              <path d="M17 2C9 2 3 8 3 16c0 11 14 26 14 26s14-15 14-26C31 8 25 2 17 2z" fill="#1b211e"></path>
              <circle cx="17" cy="16" r="5" fill="#e3b23c"></circle>
            </svg>
            <span class="mono map-tag">Rothwells Running</span>
          </span>
          <span class="map-cta">Get directions →</span>
        </a>
      </div>

      <div class="spot">
        <svg class="pin" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"></path>
        </svg>
        <div class="spot-text">
          <span class="mono label">Or train online</span>
          <h3 class="display where-title">Anywhere you run</h3>
          <p>Your plan, check-ins and support, wherever you live and train.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    padding-block: clamp(56px, 8svh, 80px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4svh, 44px);
  }
  /* On desktop the section fills exactly one screen, content centred. */
  @media (min-width: 901px) {
    .services {
      min-height: 100svh;
      display: flex;
      align-items: center;
    }
    .inner {
      flex: 1;
    }
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 24px 48px;
    flex-wrap: wrap;
  }
  .title {
    font-size: clamp(44px, 5.4vw, 80px);
  }
  .lede {
    margin: 0;
    max-width: 380px;
    color: var(--ink-soft);
  }
  .label {
    color: var(--ink-muted);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 2px solid var(--granite);
  }
  .card {
    padding: 28px 32px 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-right: 1px solid var(--chalk-line);
  }
  .card:first-child {
    padding-left: 0;
  }
  .card:last-child {
    border-right: 0;
    padding-right: 0;
  }
  .name {
    font-size: 36px;
    font-weight: 800;
  }
  .price {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .amount {
    font-size: 60px;
    line-height: 1;
  }
  .per {
    color: var(--ink-muted);
  }
  ul {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--ink-soft);
    font-size: 16px;
  }

  .where {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 16px;
  }
  .spot {
    display: flex;
    align-items: center;
    gap: 20px;
    background: #e4e3dd;
    border-radius: 10px;
    padding: 22px 24px;
  }
  .pin {
    flex: none;
    color: var(--granite);
  }
  .spot-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .spot-text p {
    margin: 0;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .where-title {
    font-size: 30px;
  }
  /* In-person card: address on the left, a stylised map filling the right. */
  .spot--map {
    padding: 0;
    align-items: stretch;
    overflow: hidden;
    gap: 0;
  }
  .spot--map .spot-text {
    padding: 22px 24px;
    justify-content: center;
  }
  .map {
    position: relative;
    flex: 0 0 42%;
    min-height: 150px;
    display: block;
    text-decoration: none;
    background-color: var(--chalk-2);
    background-image:
      linear-gradient(var(--chalk-line) 2px, transparent 2px),
      linear-gradient(90deg, var(--chalk-line) 2px, transparent 2px);
    background-size: 40px 40px;
    background-position: -6px -10px;
  }
  /* A couple of "main roads" so it reads as a map rather than a grid. */
  .map::before,
  .map::after {
    content: '';
    position: absolute;
    background: #f7f6f2;
  }
  .map::before {
    left: -10%;
    right: -10%;
    top: 58%;
    height: 10px;
    transform: rotate(-8deg);
  }
  .map::after {
    top: -10%;
    bottom: -10%;
    left: 30%;
    width: 8px;
    transform: rotate(14deg);
  }
  .map-pin {
    position: absolute;
    left: 52%;
    top: 46%;
    z-index: 1;
    transform: translate(-50%, -85%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .map-tag {
    background: var(--granite);
    color: var(--chalk);
    padding: 3px 7px;
    border-radius: 3px;
    font-size: 10px;
    white-space: nowrap;
  }
  .map-cta {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 1;
    background: var(--granite);
    color: var(--chalk);
    font-weight: 700;
    font-size: 14px;
    padding: 9px 14px;
    border-radius: 999px;
    transition: background-color 0.15s ease;
  }
  .map:hover .map-cta {
    background: var(--panel);
  }

  @media (max-width: 1100px) {
    .where {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 900px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
    .card,
    .card:first-child,
    .card:last-child {
      padding: 28px 0;
      border-right: 0;
      border-bottom: 1px solid var(--chalk-line);
    }
    .spot {
      flex-wrap: wrap;
    }
    .spot--map {
      flex-direction: column;
    }
    .map {
      flex-basis: auto;
      min-height: 180px;
    }
  }
</style>
