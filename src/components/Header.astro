---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { href } from '../lib/url';

const links = [
  { label: 'Coaching', path: '/#coaching' },
  { label: 'Run Club', path: '/#runclub' },
  { label: 'Journal', path: '/journal/' },
  { label: 'About Peter', path: '/#about' },
];
---

<header class="wrap header">
  <Logo />
  <nav class="links" aria-label="Main">
    {links.map((l) => (
      <a href={href(l.path)}>{l.label}</a>
    ))}
  </nav>
  <div class="actions">
    <ThemeToggle />
    <a class="btn cta" href={href('/#contact')}>
      Book a free chat
    </a>

    <details class="mobile">
      <summary aria-label="Menu">
        <svg
          width="26"
          height="26"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </summary>
      <nav class="sheet" aria-label="Mobile">
        {links.map((l) => (
          <a href={href(l.path)}>{l.label}</a>
        ))}
        <a class="btn" href={href('/#contact')}>
          Book a free chat
        </a>
      </nav>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details.mobile').forEach((menu) => {
    const toggle = menu.querySelector('summary')!;
    const close = () => menu.removeAttribute('open');

    // Close after jumping to a section on the same page.
    menu.querySelectorAll('.sheet a').forEach((a) => a.addEventListener('click', close));
    // Escape closes the menu and puts focus back on the menu button.
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        close();
        toggle.focus();
      }
    });
    // Close when focus moves on past the last link, so it doesn't cover the page.
    menu.addEventListener('focusout', (event) => {
      if (!menu.contains(event.relatedTarget as Node | null)) close();
    });
  });
</script>

<style>
  .header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }
  .links {
    display: flex;
    gap: 28px;
    font-weight: 500;
    font-size: 15px;
  }
  .links a {
    color: var(--muted-2);
    text-decoration: none;
    padding-block: 6px;
  }
  .links a:hover {
    color: var(--chalk);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .mobile {
    display: none;
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .sheet {
    position: absolute;
    right: var(--gutter);
    left: var(--gutter);
    top: calc(100% - 8px);
    z-index: 5;
    background: var(--granite-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .sheet a:not(.btn) {
    padding: 12px;
    text-decoration: none;
    font-weight: 600;
    font-size: 18px;
  }
  .sheet .btn {
    margin-top: 8px;
  }

  @media (max-width: 900px) {
    .links,
    .cta {
      display: none;
    }
    .mobile {
      display: block;
    }
  }
  /* Very narrow screens (or 400% zoom): tighter spacing so everything fits. */
  @media (max-width: 360px) {
    .header {
      gap: 12px;
    }
    .actions {
      gap: 8px;
    }
    summary,
    .actions :global(.theme-toggle) {
      width: 44px;
      height: 44px;
    }
  }
</style>
