---
import Carousel from './Carousel.astro';
import site from '../data/site.json';
import { href } from '../lib/url';
import { slidesFor, type SitePhoto } from '../lib/photos';

const { eyebrow, headline, intro, badge, buttons } = site.hero;
const last = headline.length - 1;
// Photos set in the admin area, already cropped to the box's shape (4:5).
const slides = slidesFor((site.hero as { photos?: SitePhoto[] }).photos);
const sizes = '(max-width: 900px) 100vw, min(37vw, 450px)';
---

<section class="wrap hero">
  <div class="copy">
    <span class="mono accent">{eyebrow}</span>
    <div class="message">
      <h1 class="display">
        {headline.map((line, i) => (
          <span class:list={['line', { accent: i === last }]}>{line}</span>
        ))}
      </h1>
      <p class="intro">{intro}</p>
    </div>
    <div class="ctas">
      <a class="btn" href={href('/#coaching')}>
        {buttons.primary}
      </a>
      <a class="btn btn--ghost" href={href('/#runclub')}>
        {buttons.secondary}
      </a>
    </div>
  </div>

  <Carousel
    class="hero-photo"
    slides={slides}
    sizes={sizes}
    priority
    tint
    label="Photos of Peter"
    placeholder="Peter on a hill trail, mid-run. Full-bleed, high-contrast action shot."
  >
    {badge.value && (
      <div class="badge">
        <span class="mono">{badge.label}</span>
        <span class="display">{badge.value}</span>
      </div>
    )}
  </Carousel>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: 48px;
    align-items: stretch;
    padding-block: 24px 40px;
  }
  /* On desktop the text spans the photo's full height: the small line level with
     its top, the buttons level with its bottom, the headline spaced in between. */
  .copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
  }
  .message {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  /* Scales with both width and height so the three lines never wrap
     and the hero still fits on shorter laptop screens. */
  h1 {
    font-size: clamp(52px, min(6.3vw, 10svh), 88px);
  }
  .line {
    display: block;
  }
  .intro {
    margin: 0;
    font-size: 20px;
    max-width: 34em;
    color: var(--muted-2);
  }
  .ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  /* The photo stretches to whatever height the first screen leaves it. */
  .hero :global(.hero-photo) {
    min-height: 320px;
  }
  .badge {
    position: absolute;
    top: 18px;
    right: 18px;
    background: var(--granite);
    padding: 10px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .badge .mono {
    font-size: 10px;
    color: var(--muted);
  }
  .badge .display {
    font-size: 30px;
    font-weight: 800;
    color: var(--chalk);
  }

  /* Shorter laptop screens (e.g. 1366×768): tighten spacing to stay on one screen. */
  @media (min-width: 901px) and (max-height: 820px) {
    /* The preview bar, when shown, takes its room from the bottom padding. */
    .hero {
      padding-block: 12px calc(28px - var(--preview-h) / 2);
    }
    .copy,
    .message {
      gap: 20px;
    }
    .intro {
      font-size: 18px;
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 8px;
    }
    /* Same 4:5 shape as the saved photos, but never taller than most of the screen. */
    .hero :global(.hero-photo) {
      aspect-ratio: 4 / 5;
      max-height: 75svh;
    }
  }
</style>
