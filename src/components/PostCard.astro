---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import { href } from '../lib/url';
import { readingTime } from '../lib/journal';

interface Props {
  post: CollectionEntry<'journal'>;
  /** Heading level for the title, so headings stay in order on each page. */
  level?: 'h2' | 'h3';
}

const { post, level: Heading = 'h3' } = Astro.props;
const minutes = readingTime(post);
// The link is named by the title alone; the date and topic are its description.
const titleId = `post-${post.id}-title`;
const metaId = `post-${post.id}-meta`;
const { title, topic, date, cover } = post.data;
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<a class="post" href={href(`/journal/${post.id}/`)} aria-labelledby={titleId} aria-describedby={metaId}>
  <Photo
    class="cover"
    tone="light"
    src={cover}
    alt=""
    sizes="(max-width: 900px) 100vw, min(31vw, 365px)"
    widths={[400, 800, 1100]}
  >
    {!cover && <span class="mono ph">Cover image</span>}
  </Photo>
  <span class="mono meta" id={metaId}>
    {topic} · <time datetime={date.toISOString()}>{dateLabel}</time> · {minutes}
  </span>
  <Heading class="post-title" id={titleId}>
    {title}
  </Heading>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
  }
  .post :global(.cover) {
    aspect-ratio: 3 / 2;
  }
  .ph {
    padding: 14px;
  }
  .meta {
    color: var(--ink-muted);
  }
  .post-title {
    margin: 0;
    font-size: 24px;
    line-height: 1.25;
    font-weight: 700;
    text-wrap: balance;
  }
  .post:hover .post-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
