---
import type { CollectionEntry } from 'astro:content';
import Photo from './Photo.astro';
import { href } from '../lib/url';
import { readingTime } from '../lib/journal';
import { PREVIEW } from 'astro:env/server';
import site from '../data/site.json';

interface Props {
  post: CollectionEntry<'journal'>;
  /** Heading level for the title, so headings stay in order on each page. */
  level?: 'h2' | 'h3';
}

const { post, level: Heading = 'h3' } = Astro.props;
const minutes = readingTime(post);
// The link is named by its visible text, in the order it shows (topic, date,
// reading time, then title), so speech-input users can say what they see (WCAG 2.5.3).
const { title, topic, date, cover, sample } = post.data;
// Example posts written for the preview are labelled there, so nobody mistakes them for Peter's own.
const showSample = PREVIEW && sample;
const dateLabel = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<a class="post" href={href(`/journal/${post.id}/`)}>
  <Photo
    class="cover"
    tone="light"
    src={cover}
    alt=""
    sizes="(max-width: 900px) 100vw, min(31vw, 365px)"
    widths={[400, 800, 1100]}
  >
    {!cover && <span class="mono ph">Cover image</span>}
    {showSample && <span class="mono sample">{site.journal.sampleLabel}</span>}
  </Photo>
  <span class="mono meta">
    {topic} · <time datetime={date.toISOString()}>{dateLabel}</time> · {minutes}
  </span>
  <Heading class="post-title">{title}</Heading>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 14px;
    text-decoration: none;
  }
  .post :global(.cover) {
    aspect-ratio: 3 / 2;
  }
  .ph {
    padding: 14px;
  }
  .sample {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 5px 8px;
    font-size: 11px;
    background: var(--gorse);
    color: var(--ink);
  }
  .meta {
    color: var(--ink-muted);
  }
  .post-title {
    margin: 0;
    font-size: 24px;
    line-height: 1.25;
    font-weight: 700;
    text-wrap: balance;
  }
  .post:hover .post-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
