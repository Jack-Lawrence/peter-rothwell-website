---
import { href } from '../lib/url';

// The order matters, so these are numbered steps rather than features.
const steps = [
  { title: 'Free 15-minute chat', text: 'We talk about where you are now and where you want to get to.' },
  { title: 'Your plan, written for you', text: 'I build it around your life, your body and the race you’re chasing.' },
  { title: 'Train, check in, adjust', text: 'You train, we check in every week, and I adjust the plan as you go.' },
];
---

<section class="how" aria-labelledby="how-title">
  <div class="wrap inner">
    <div class="head">
      <span class="mono accent">How it works</span>
      <h2 id="how-title" class="display title">Three steps to start</h2>
    </div>
    <ol class="steps">
      {
        steps.map((s, i) => (
          <li>
            <span class="display num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
    <a class="btn" href={href('/#contact')}>Book a free chat</a>
  </div>
</section>

<style>
  .how {
    background: var(--granite-2);
    border-bottom: 1px solid var(--line);
  }
  .inner {
    padding-block: clamp(48px, 6vw, 72px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'head btn' 'steps steps';
    gap: 32px 48px;
    align-items: end;
  }
  .head {
    grid-area: head;
  }
  .steps {
    grid-area: steps;
  }
  .btn {
    grid-area: btn;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .title {
    font-size: clamp(36px, 3.6vw, 52px);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 2px solid var(--line);
  }
  .num {
    font-size: 44px;
    color: var(--gorse);
  }
  h3 {
    margin: 0;
    font-size: 19px;
    line-height: 1.3;
  }
  p {
    margin: 0;
    color: var(--muted-2);
    font-size: 16px;
    line-height: 1.5;
  }
  .btn {
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .inner {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'head' 'steps' 'btn';
    }
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .btn {
      justify-self: start;
    }
  }
</style>
