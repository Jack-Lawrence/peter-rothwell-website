---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WeekStrip from '../components/WeekStrip.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Testimonials from '../components/Testimonials.astro';
import JournalPreview from '../components/JournalPreview.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Faq from '../components/Faq.astro';
import JsonLd from '../components/JsonLd.astro';
import { faqSchema, homeSchema } from '../lib/schema';

const faqData = faqSchema();
---

<Base>
  <JsonLd slot="head" data={homeSchema()} />
  {faqData && <JsonLd slot="head" data={faqData} />}
  <div class="first-screen">
    <Hero />
    <WeekStrip />
  </div>
  <Services />
  <HowItWorks />
  <About />
  <Testimonials />
  <JournalPreview />
  <Faq />
  <InstagramFeed />
</Base>

<style>
  /* On desktop the hero and week strip fill exactly one screen below the
     header (and the preview bar, if shown); the hero photo takes up whatever height is left. */
  @media (min-width: 901px) {
    .first-screen {
      display: flex;
      flex-direction: column;
      min-height: calc(100svh - var(--header-h) - var(--preview-h));
      padding-bottom: 32px;
    }
    .first-screen > :global(.hero) {
      flex: 1;
    }
  }
</style>
