---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href } from '../lib/url';

// One page per file in src/content/legal/: /privacy/, /terms/, /refunds/, /accessibility/.
export const getStaticPaths = (async () => {
  const pages = await getCollection('legal');
  return pages.map((page) => ({ params: { legal: page.id }, props: { page } }));
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { Content } = await render(page);
const { title, description, updated } = page.data;
const updatedLabel = updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
// Quick links to every policy, in the same order as the footer.
const policies = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={title} description={description}>
  <article class="light section">
    <div class="wrap narrow">
      <div class="top">
        <a class="back" href={href('/')}>
          ← Back to home
        </a>
        <nav aria-label="All policies">
          <ul class="others">
            {policies.map((p) => (
              <li>
                <a class="mono" href={href(`/${p.id}/`)} aria-current={p.id === page.id ? 'page' : undefined}>
                  {p.data.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <p class="mono meta">
        Last updated <time datetime={updated.toISOString()}>{updatedLabel}</time>
      </p>
      <h1 class="display title">{title}</h1>
      <div class="body">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .narrow {
    max-width: calc(760px + 2 * var(--gutter));
  }
  /* Back link and quick links to the other policies. */
  .top {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 24px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--chalk-line);
  }
  .back {
    align-self: flex-start;
    font-weight: 700;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .others {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .others a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    font-size: 11px;
    text-decoration: none;
    color: var(--granite);
    border: 1.5px solid var(--chalk-line);
  }
  .others a:hover {
    border-color: var(--granite);
  }
  .others a[aria-current='page'] {
    background: var(--granite);
    border-color: var(--granite);
    color: var(--chalk);
  }
  .meta {
    color: var(--ink-muted);
    margin: 0 0 16px;
  }
  .title {
    font-size: clamp(44px, 6vw, 80px);
    margin-bottom: 40px;
  }
  .body {
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .body :global(h2) {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: 30px;
    line-height: 1;
    color: var(--granite);
    margin: 48px 0 14px;
  }
  .body :global(h3) {
    font-size: 19px;
    color: var(--granite);
    margin: 28px 0 8px;
  }
  .body :global(p),
  .body :global(ul) {
    margin: 0 0 16px;
  }
  .body :global(li + li) {
    margin-top: 6px;
  }
  .body :global(strong) {
    color: var(--granite);
  }
  .body :global(a) {
    color: var(--granite);
    font-weight: 600;
  }
  .body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 20px;
    display: block;
    overflow-x: auto;
  }
  .body :global(th),
  .body :global(td) {
    text-align: left;
    padding: 10px 16px 10px 0;
    border-bottom: 1px solid var(--chalk-line);
    vertical-align: top;
  }
  .body :global(th) {
    font-family: var(--font-mono);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    border-bottom: 2px solid var(--granite);
  }
  /* Placeholders Peter still needs to fill in. */
  .body :global(mark) {
    background: color-mix(in srgb, var(--gorse) 55%, white);
    color: var(--granite);
    padding: 1px 4px;
  }
</style>
