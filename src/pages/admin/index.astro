---
// The website editor for Peter. A small app that edits the content files:
// in demo mode the changes stay in the browser, in live mode they're
// committed to GitHub (see src/admin/store.ts and docs/admin-guide.md).
import '@fontsource/sofia-sans-extra-condensed/800';
import '@fontsource-variable/figtree';
import '@fontsource/jetbrains-mono/500';
import '../../styles/global.css';
import '../../admin/admin.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ADMIN_REPO, PREVIEW } from 'astro:env/server';
import { absolute, href } from '../../lib/url';
import { jsonForScript } from '../../lib/json-script';

// The content as it is now, for demo mode to start from.
const raw = import.meta.glob<string>(['/src/data/*.json', '/src/content/journal/*.md', '/src/content/legal/*.md'], {
  query: '?raw',
  import: 'default',
  eager: true,
});
const files = Object.fromEntries(Object.entries(raw).map(([path, text]) => [path.slice(1), text]));

// Small previews of the photos already on the site, so the editor can show them.
const photos = import.meta.glob<ImageMetadata>('/src/assets/{journal,photos,library}/*.{jpg,jpeg,png,webp}', {
  import: 'default',
  eager: true,
});
const images: Record<string, string> = {};
// Full-size library photos, so demo mode can crop them for a slot.
const originals: Record<string, string> = {};
for (const [path, image] of Object.entries(photos)) {
  images[path.slice(1)] = (await getImage({ src: image, width: 1000, format: 'webp' })).src;
  if (path.startsWith('/src/assets/library/')) originals[path.slice(1)] = image.src;
}

const config = { repo: ADMIN_REPO, preview: PREVIEW, siteUrl: absolute('/'), baked: { files, images, originals } };
// Escaped so no content (a post, an FAQ answer) can close the script tag early.
const json = jsonForScript(config);

// Content-Security-Policy for the editor: it only talks to this site and the GitHub API.
// Astro bundles the editor's script into a file, so no inline scripts need allowing
// (the config above is JSON, which browsers don't run). Left out in `astro dev`, whose
// live reload uses inline scripts and a websocket.
const csp = [
  "default-src 'self'",
  "connect-src 'self' https://api.github.com",
  "img-src 'self' data: blob:",
  // Small font subsets are inlined into the CSS as data: URLs.
  "font-src 'self' data:",
  "style-src 'self' 'unsafe-inline'",
  "script-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');

// Each section of the home page is edited from "Your website".
const nav = [
  ['#/', 'Home'],
  ['#/website', 'Your website'],
  ['#/posts', 'Blog posts'],
  ['#/photos', 'Photos'],
  ['#/theme', 'Colours'],
  ['#/contact', 'Contact details'],
  ['#/policies', 'Policies'],
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="robots" content="noindex, nofollow" />
    <title>Website editor | Rothwells Running</title>
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta name="theme-color" content="#1b211e" />
  </head>
  <body class="admin">
    <a class="skip" href="#view">
      Skip to content
    </a>
    <div class="shell">
      <aside class="side" aria-label="Editor menu">
        <div class="side-top">
          <div class="brand">
            Rothwells Running
            <span>Website editor</span>
          </div>
          <button id="menu-btn" class="menu-btn" type="button" aria-controls="side-nav">
            Menu
          </button>
        </div>
        <nav class="side-nav" id="side-nav" aria-label="Editor">
          {nav.map(([to, label]) => (
            <a href={to}>{label}</a>
          ))}
          <a href={href('/')} target="_blank" rel="noopener">
            View my website ↗
          </a>
          <div class="side-foot" id="side-foot"></div>
        </nav>
      </aside>
      <div class="main-col">
        <p class="mode-banner" id="mode-banner" role="note" hidden></p>
        <div class="deploy-status" id="deploy-status" role="status" aria-live="polite" hidden></div>
        <main id="view" class="view" tabindex="-1">
          <p class="loading">Loading…</p>
        </main>
      </div>
    </div>
    <div id="toasts" class="toasts" role="status" aria-live="polite"></div>
    <noscript>
      <p class="noscript">The website editor needs JavaScript. Please turn it on and reload.</p>
    </noscript>
    <script id="admin-config" type="application/json" set:html={json} />
    <script>
      import '../../admin/main';
    </script>
  </body>
</html>
