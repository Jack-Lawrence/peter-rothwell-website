---
// The website editor for Peter. A small app that edits the content files:
// in demo mode the changes stay in the browser, in live mode they're
// committed to GitHub (see src/admin/store.ts and docs/admin-guide.md).
import '@fontsource/big-shoulders-display/800';
import '@fontsource-variable/figtree';
import '@fontsource/jetbrains-mono/500';
import '../../styles/global.css';
import '../../admin/admin.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { ADMIN_REPO, PREVIEW } from 'astro:env/server';
import { absolute, href } from '../../lib/url';

// The content as it is now, for demo mode to start from.
const raw = import.meta.glob<string>(['/src/data/*.json', '/src/content/journal/*.md', '/src/content/legal/*.md'], {
  query: '?raw',
  import: 'default',
  eager: true,
});
const files = Object.fromEntries(Object.entries(raw).map(([path, text]) => [path.slice(1), text]));

// Small previews of the photos already on the site, so the editor can show them.
const photos = import.meta.glob<ImageMetadata>('/src/assets/{demo,journal}/*.{jpg,jpeg,png,webp}', {
  import: 'default',
  eager: true,
});
const images: Record<string, string> = {};
for (const [path, image] of Object.entries(photos)) {
  images[path.slice(1)] = (await getImage({ src: image, width: 1000, format: 'webp' })).src;
}

const config = { repo: ADMIN_REPO, preview: PREVIEW, siteUrl: absolute('/'), baked: { files, images } };
const json = JSON.stringify(config).replace(/</g, '\u003c');

const nav = [
  ['#/', 'Home'],
  ['#/posts', 'Blog posts'],
  ['#/prices', 'Services & prices'],
  ['#/runclub', 'Run Club dates'],
  ['#/testimonials', 'Testimonials'],
  ['#/week', 'Typical week'],
  ['#/contact', 'Contact details'],
  ['#/policies', 'Policies'],
  ['#/instagram', 'Instagram feed'],
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Website editor | Rothwells Running</title>
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <meta name="theme-color" content="#1b211e" />
  </head>
  <body class="admin">
    <a class="skip" href="#view">Skip to content</a>
    <div class="shell">
      <aside class="side" aria-label="Editor menu">
        <div class="side-top">
          <div class="brand">
            Rothwells Running
            <span>Website editor</span>
          </div>
          <button id="menu-btn" class="menu-btn" type="button" aria-controls="side-nav">Menu</button>
        </div>
        <nav class="side-nav" id="side-nav" aria-label="Editor">
          {nav.map(([to, label]) => <a href={to}>{label}</a>)}
          <a href={href('/')} target="_blank" rel="noopener">View my website ↗</a>
          <div class="side-foot" id="side-foot"></div>
        </nav>
      </aside>
      <div class="main-col">
        <p class="mode-banner" id="mode-banner" role="note" hidden></p>
        <main id="view" class="view" tabindex="-1">
          <p class="loading">Loading…</p>
        </main>
      </div>
    </div>
    <div id="toasts" class="toasts" role="status" aria-live="polite"></div>
    <noscript><p class="noscript">The website editor needs JavaScript. Please turn it on and reload.</p></noscript>
    <script id="admin-config" type="application/json" set:html={json} />
    <script>
      import '../../admin/main';
    </script>
  </body>
</html>
