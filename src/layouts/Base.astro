---
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/figtree';
import '@fontsource/jetbrains-mono/500';
import '../styles/global.css';
// The hero headline's font, preloaded so the first screen doesn't wait for it.
import headlineFont from '@fontsource/big-shoulders-display/files/big-shoulders-display-latin-900-normal.woff2?url';
import Header from '../components/Header.astro';
import PreviewBar from '../components/PreviewBar.astro';
import ContactFooter from '../components/ContactFooter.astro';
import site from '../data/site.json';
import { absolute, href } from '../lib/url';
import { PREVIEW } from 'astro:env/server';

interface Props {
  title?: string;
  description?: string;
  /** Share image (e.g. a blog post's cover); defaults to public/og-default.png. */
  image?: { url: string; width: number; height: number; alt: string };
  type?: 'website' | 'article';
}

const { title, description = site.description, image, type = 'website' } = Astro.props;
// Search results cut titles at about 60–70 characters, so long titles drop the site name.
const withName = title ? `${title} | ${site.name}` : `${site.name} | Running & strength coaching, Edinburgh`;
const pageTitle = title && withName.length > 70 ? title : withName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = image ?? {
  url: absolute('/og-default.png'),
  width: 1200,
  height: 630,
  alt: `${site.name}: running & strength coaching in Edinburgh and online`,
};
---

<!doctype html>
<html lang="en-GB" class:list={{ 'has-preview': PREVIEW }}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="preload" href={headlineFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name}: training journal`} href={href('/journal/rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={share.url} />
    <meta property="og:image:width" content={String(share.width)} />
    <meta property="og:image:height" content={String(share.height)} />
    <meta property="og:image:alt" content={share.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1b211e" />
    {PREVIEW && <meta name="robots" content="noindex, nofollow" />}
    <slot name="head" />
    {
      PREVIEW && (
        <script is:inline>
          try {
            if (sessionStorage.getItem('preview-hidden')) document.documentElement.classList.add('preview-hidden');
          } catch {}
        </script>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {PREVIEW && <PreviewBar />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <ContactFooter />
  </body>
</html>

<script>
  // Smooth-scroll links to sections on the current page (e.g. "/#coaching"
  // while on the home page). Links written with the base path don't always
  // count as same-page jumps, so CSS scroll-behavior alone isn't enough.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;

    const url = new URL(link.href);
    if (url.origin !== location.origin || url.pathname !== location.pathname || !url.hash) return;

    const target = document.getElementById(decodeURIComponent(url.hash.slice(1)));
    if (!target) return;

    event.preventDefault();
    target.scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
    history.pushState(null, '', url.hash);
  });
</script>

<style>
  .skip {
    position: absolute;
    left: 16px;
    top: -60px;
    z-index: 10;
    background: var(--gorse);
    color: var(--granite);
    padding: 10px 16px;
    border-radius: 6px;
    font-weight: 700;
  }
  .skip:focus {
    top: 16px;
  }
</style>
